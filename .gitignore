# ASTRA - Git Ignore

# ======================
# SECURITY & SECRETS
# ======================
.env
.env.local
.env.production
*.key
*.pem
secrets/
*.secret

# ======================
# PYTHON
# ======================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
.venv/
ENV/
env/

# ======================
# DATABASES
# ======================
*.db
*.sqlite
*.sqlite3

# ======================
# DADOS DE RUNTIME / PESSOAIS
# ======================
# Histórico de conversas, memórias, perfis e preferências —
# gerados em execução, nunca devem ser commitados.
data/
astra/data/conversation/
astra/data/memory/
astra/data/personality/
astra/data/user/
astra/data/companion/emotional_memory.json
astra/data/*.json
astra/config/data/
astra/config/logs/
astra/modules/speech/recorded_audio/
astra/modules/speech/cloned_voices/

# ======================
# LOGS
# ======================
logs/
*.log
jarvis/logs/

# ======================
# IDE
# ======================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ======================
# MODELS & DATA
# ======================
neural_models/*.pth
neural_models/*.pt
neural_models/*.bin
models/
checkpoints/
*.pkl
*.joblib

# ======================
# TEMPORARY
# ======================
tmp/
temp/
*.tmp
*.bak
*.cache

# ======================
# DOCKER
# ======================
docker-compose.override.yml

# ======================
# PYTEST
# ======================
.pytest_cache/
.coverage
htmlcov/
.tox/
