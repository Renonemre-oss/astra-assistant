# ASTRA - Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores

# ==============================================================================
# CONFIGURAÇÕES DE IA
# ==============================================================================

# Ollama (Local - Recomendado)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=dolphin-llama3:8b

# OpenAI (Opcional - para fallback)
#OPENAI_API_KEY=sua-chave-aqui

# ==============================================================================
# DATABASE
# ==============================================================================

# SQLite (padrão — usado quando DATABASE_URL não está definido)
DATABASE_PATH=ASTRA_assistant.db

# MySQL remoto (ex.: Railway)
# No Railway: cria um serviço MySQL e copia o valor de MYSQL_URL
# (aba "Variables" do serviço) para aqui:
#DATABASE_URL=mysql://root:password@host.railway.app:3306/railway

# ======================
# OPTIONAL API KEYS
# ======================

# News API (newsdata.io)
#NEWSDATA_API_KEY=

# Weather API (OpenWeatherMap)
#OPENWEATHER_API_KEY=

# Alpha Vantage (Stocks)
#ALPHAVANTAGE_API_KEY=

# ElevenLabs (Voice Cloning)
#ELEVENLABS_API_KEY=

# Google API Key
#GOOGLE_API_KEY=

# ======================
# SECURITY
# ======================

# Admin password (for protected endpoints)
#ADMIN_PASSWORD=

# ======================
# APP SETTINGS
# ======================

# Environment (development, production)
ENVIRONMENT=development

# Debug mode
DEBUG=true

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
